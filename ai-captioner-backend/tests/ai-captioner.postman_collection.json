                }
              ]
            },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Create post - file too large",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 413\", () => pm.response.to.have.status(413));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "tests/fixtures/too-large.png"
                }
              ]
            },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Create post - success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const post = pm.response.json();",
                  "pm.test(\"has a real caption\", () => {",
                  "  pm.expect(post.caption).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(post.caption).to.not.eql(\"AI caption unavailable\");",
                  "});",
                  "pm.test(\"image keeps .png extension\", () => pm.expect(post.image.split(\"?\")[0]).to.match(/[.]png$/));",
                  "console.log(\"Caption:\", post.caption, \"| Image:\", post.image);",
                  "pm.collectionVariables.set(\"postId\", post._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "tests/fixtures/sample.png"
                }
              ]
            },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Get all posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"includes new post\", () =>",
                  "  pm.expect(pm.response.json().map(p => p._id)).to.include(pm.collectionVariables.get(\"postId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Get my posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const posts = pm.response.json();",
                  "pm.test(\"only my posts\", () => posts.forEach(p => pm.expect(p.user.username).to.eql(pm.collectionVariables.get(\"username\"))));",
                  "pm.test(\"includes new post\", () => pm.expect(posts.map(p => p._id)).to.include(pm.collectionVariables.get(\"postId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/posts/me"
          }
        },
