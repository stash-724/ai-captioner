    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": "tests/fixtures/sample.png"
                }
              ]
            },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Create post - bad token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
