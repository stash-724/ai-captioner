            "url": "{{baseUrl}}/api/posts"
          }
        },
        {
          "name": "Create post - wrong file type",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
