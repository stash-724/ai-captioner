          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"dup_{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
